generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model activitylog {
  id         String   @id
  action     String
  entityType String
  entityId   String?
  metadata   String?  @db.LongText
  createdAt  DateTime @default(now())
  tenantId   String?
  userId     String?
  tenant     tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "ActivityLog_tenantId_fkey")
  user       user?    @relation(fields: [userId], references: [id], map: "ActivityLog_userId_fkey")

  @@index([tenantId], map: "ActivityLog_tenantId_fkey")
  @@index([userId], map: "ActivityLog_userId_fkey")
}

model beneficiary {
  id                                                                       String                  @id
  code                                                                     String
  name                                                                     String
  telephone                                                                String?
  gender                                                                   beneficiary_gender?
  dateOfBirth                                                              DateTime?
  status                                                                   beneficiary_status      @default(ACTIVE)
  province                                                                 String?
  district                                                                 String?
  sector                                                                   String?
  nationalId                                                               String?
  householdSize                                                            Int?
  createdAt                                                                DateTime                @default(now())
  updatedAt                                                                DateTime
  tenantId                                                                 String
  consentAt                                                                DateTime?
  consentGiven                                                             Boolean                 @default(false)
  outcome                                                                  beneficiary_outcome     @default(PENDING)
  cell                                                                     String?
  village                                                                  String?
  tenant                                                                   tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Beneficiary_tenantId_fkey")
  beneficiaryassignment                                                    beneficiaryassignment[]
  fieldvisit                                                               fieldvisit[]
  replacementrequest_replacementrequest_candidateRespondentIdTobeneficiary replacementrequest[]    @relation("replacementrequest_candidateRespondentIdTobeneficiary")
  replacementrequest_replacementrequest_originalRespondentIdTobeneficiary  replacementrequest[]    @relation("replacementrequest_originalRespondentIdTobeneficiary")
  program                                                                  program[]               @relation("beneficiarytoprogram")

  @@unique([tenantId, code], map: "Beneficiary_tenantId_code_key")
  @@unique([tenantId, nationalId], map: "Beneficiary_tenantId_nationalId_key")
}

model beneficiaryassignment {
  id            String                               @id
  status        beneficiaryassignment_status         @default(ACTIVE)
  assignedAt    DateTime                             @default(now())
  endedAt       DateTime?
  createdAt     DateTime                             @default(now())
  updatedAt     DateTime
  beneficiaryId String
  userId        String
  tenantId      String
  transportMode beneficiaryassignment_transportMode?
  vehicleId     String?
  beneficiary   beneficiary                          @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade, map: "BeneficiaryAssignment_beneficiaryId_fkey")
  tenant        tenant                               @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "BeneficiaryAssignment_tenantId_fkey")
  user          user                                 @relation(fields: [userId], references: [id], onDelete: Cascade, map: "BeneficiaryAssignment_userId_fkey")
  vehicle       vehicle?                             @relation(fields: [vehicleId], references: [id], map: "BeneficiaryAssignment_vehicleId_fkey")

  @@index([beneficiaryId], map: "BeneficiaryAssignment_beneficiaryId_fkey")
  @@index([tenantId], map: "BeneficiaryAssignment_tenantId_fkey")
  @@index([userId], map: "BeneficiaryAssignment_userId_fkey")
  @@index([vehicleId], map: "BeneficiaryAssignment_vehicleId_fkey")
}

model fieldcheckin {
  id                     String       @id
  checkInAt              DateTime     @default(now())
  checkOutAt             DateTime?
  gpsLat                 Float?
  gpsLng                 Float?
  note                   String?
  tenantId               String
  userId                 String
  projectId              String?
  currentGpsLat          Float?
  currentGpsLng          Float?
  currentGpsAt           DateTime?
  currentGpsNote         String?
  checkoutOverrideReason String?
  program                program?     @relation(fields: [projectId], references: [id], map: "FieldCheckIn_projectId_fkey")
  tenant                 tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "FieldCheckIn_tenantId_fkey")
  user                   user         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "FieldCheckIn_userId_fkey")
  fieldnote              fieldnote[]
  fieldvisit             fieldvisit[]

  @@index([projectId], map: "FieldCheckIn_projectId_fkey")
  @@index([tenantId], map: "FieldCheckIn_tenantId_fkey")
  @@index([userId], map: "FieldCheckIn_userId_fkey")
}

model fieldnote {
  id           String       @id
  note         String
  createdAt    DateTime     @default(now())
  checkInId    String
  fieldcheckin fieldcheckin @relation(fields: [checkInId], references: [id], onDelete: Cascade, map: "FieldNote_checkInId_fkey")

  @@index([checkInId], map: "FieldNote_checkInId_fkey")
}

model fieldvisit {
  id            String             @id
  outcome       fieldvisit_outcome @default(PENDING)
  note          String?
  recordedAt    DateTime           @default(now())
  checkInId     String
  beneficiaryId String
  beneficiary   beneficiary        @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade, map: "FieldVisit_beneficiaryId_fkey")
  fieldcheckin  fieldcheckin       @relation(fields: [checkInId], references: [id], onDelete: Cascade, map: "FieldVisit_checkInId_fkey")

  @@unique([checkInId, beneficiaryId], map: "FieldVisit_checkInId_beneficiaryId_key")
  @@index([beneficiaryId], map: "FieldVisit_beneficiaryId_fkey")
}

model notification {
  id         String            @id
  type       notification_type
  message    String
  entityType String?
  entityId   String?
  read       Boolean           @default(false)
  createdAt  DateTime          @default(now())
  tenantId   String?
  userId     String
  tenant     tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Notification_tenantId_fkey")
  user       user              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([tenantId], map: "Notification_tenantId_fkey")
  @@index([userId], map: "Notification_userId_fkey")
}

model program {
  id                String                @id
  name              String
  description       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime
  tenantId          String
  endDate           DateTime?
  scenarioType      program_scenarioType?
  startDate         DateTime?
  status            program_status        @default(PLANNING)
  targetSampleSize  Int?
  fieldcheckin      fieldcheckin[]
  tenant            tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Program_tenantId_fkey")
  programassignment programassignment[]
  beneficiary       beneficiary[]         @relation("beneficiarytoprogram")

  @@unique([tenantId, name], map: "Program_tenantId_name_key")
}

model programassignment {
  id         String                   @id
  status     programassignment_status @default(ACTIVE)
  assignedAt DateTime                 @default(now())
  endedAt    DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime
  userId     String
  programId  String
  tenantId   String
  program    program                  @relation(fields: [programId], references: [id], onDelete: Cascade, map: "ProgramAssignment_programId_fkey")
  tenant     tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "ProgramAssignment_tenantId_fkey")
  user       user                     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ProgramAssignment_userId_fkey")

  @@index([programId], map: "ProgramAssignment_programId_fkey")
  @@index([tenantId], map: "ProgramAssignment_tenantId_fkey")
  @@index([userId], map: "ProgramAssignment_userId_fkey")
}

model replacementrequest {
  id                                                                String                         @id
  reason                                                            String
  status                                                            replacementrequest_status      @default(PENDING)
  createdAt                                                         DateTime                       @default(now())
  decidedAt                                                         DateTime?
  tenantId                                                          String
  originalRespondentId                                              String
  candidateRespondentId                                             String?
  requestedByUserId                                                 String
  decidedByUserId                                                   String?
  matchLevel                                                        replacementrequest_matchLevel?
  overrideReason                                                    String?
  beneficiary_replacementrequest_candidateRespondentIdTobeneficiary beneficiary?                   @relation("replacementrequest_candidateRespondentIdTobeneficiary", fields: [candidateRespondentId], references: [id], map: "ReplacementRequest_candidateRespondentId_fkey")
  user_replacementrequest_decidedByUserIdTouser                     user?                          @relation("replacementrequest_decidedByUserIdTouser", fields: [decidedByUserId], references: [id], map: "ReplacementRequest_decidedByUserId_fkey")
  beneficiary_replacementrequest_originalRespondentIdTobeneficiary  beneficiary                    @relation("replacementrequest_originalRespondentIdTobeneficiary", fields: [originalRespondentId], references: [id], onDelete: Cascade, map: "ReplacementRequest_originalRespondentId_fkey")
  user_replacementrequest_requestedByUserIdTouser                   user                           @relation("replacementrequest_requestedByUserIdTouser", fields: [requestedByUserId], references: [id], map: "ReplacementRequest_requestedByUserId_fkey")
  tenant                                                            tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "ReplacementRequest_tenantId_fkey")

  @@index([candidateRespondentId], map: "ReplacementRequest_candidateRespondentId_fkey")
  @@index([decidedByUserId], map: "ReplacementRequest_decidedByUserId_fkey")
  @@index([originalRespondentId], map: "ReplacementRequest_originalRespondentId_fkey")
  @@index([requestedByUserId], map: "ReplacementRequest_requestedByUserId_fkey")
  @@index([tenantId], map: "ReplacementRequest_tenantId_fkey")
}

model role {
  id          String   @id
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  tenantId    String
  permissions String?  @db.LongText
  tenant      tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Role_tenantId_fkey")
  user        user[]

  @@unique([tenantId, name], map: "Role_tenantId_name_key")
}

model tenant {
  id                    String                  @id
  name                  String                  @unique(map: "Tenant_name_key")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  activitylog           activitylog[]
  beneficiary           beneficiary[]
  beneficiaryassignment beneficiaryassignment[]
  fieldcheckin          fieldcheckin[]
  notification          notification[]
  program               program[]
  programassignment     programassignment[]
  replacementrequest    replacementrequest[]
  role                  role[]
  user                  user[]
  vehicle               vehicle[]
}

model user {
  id                                                            String                  @id
  email                                                         String                  @unique(map: "User_email_key")
  name                                                          String?
  password                                                      String
  createdAt                                                     DateTime                @default(now())
  updatedAt                                                     DateTime
  telephone                                                     String?
  province                                                      String?
  district                                                      String?
  sector                                                        String?
  gender                                                        user_gender?
  dateOfBirth                                                   DateTime?
  status                                                        user_status             @default(ACTIVE)
  educationLevel                                                user_educationLevel?
  isPlatformAdmin                                               Boolean                 @default(false)
  tokenVersion                                                  Int                     @default(0)
  roleId                                                        String?
  tenantId                                                      String?
  lastSeenAt                                                    DateTime?
  cell                                                          String?
  village                                                       String?
  activitylog                                                   activitylog[]
  beneficiaryassignment                                         beneficiaryassignment[]
  fieldcheckin                                                  fieldcheckin[]
  notification                                                  notification[]
  programassignment                                             programassignment[]
  replacementrequest_replacementrequest_decidedByUserIdTouser   replacementrequest[]    @relation("replacementrequest_decidedByUserIdTouser")
  replacementrequest_replacementrequest_requestedByUserIdTouser replacementrequest[]    @relation("replacementrequest_requestedByUserIdTouser")
  role                                                          role?                   @relation(fields: [roleId], references: [id], map: "User_roleId_fkey")
  tenant                                                        tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "User_tenantId_fkey")

  @@index([roleId], map: "User_roleId_fkey")
  @@index([tenantId], map: "User_tenantId_fkey")
}

model vehicle {
  id                    String                  @id
  name                  String
  type                  vehicle_type            @default(VEHICLE)
  driverName            String?
  capacityPerDay        Int?
  active                Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  tenantId              String
  beneficiaryassignment beneficiaryassignment[]
  tenant                tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Vehicle_tenantId_fkey")

  @@index([tenantId], map: "Vehicle_tenantId_fkey")
}

enum beneficiaryassignment_status {
  ACTIVE
  ENDED
}

enum fieldvisit_outcome {
  PENDING
  COMPLETED
  REFUSED
  NOT_FOUND
  RELOCATED
  DECEASED
  REPLACED
}

enum notification_type {
  ASSIGNMENT_PROGRAM
  ASSIGNMENT_BENEFICIARY
  REPLACEMENT_REQUESTED
  REPLACEMENT_DECIDED
  SYSTEM
}

enum programassignment_status {
  ACTIVE
  ENDED
}

enum replacementrequest_status {
  PENDING
  APPROVED
  REJECTED
}

enum vehicle_type {
  VEHICLE
  MOTORCYCLE
}

enum beneficiary_gender {
  MALE
  FEMALE
  OTHER
}

enum beneficiary_status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum program_scenarioType {
  BASELINE_SURVEY
  ENDLINE_SURVEY
  TRACER_STUDY
  PROGRAM_OUTCOME_ASSESSMENT
  QUALITATIVE_STUDY
}

enum beneficiaryassignment_transportMode {
  NONE
  VEHICLE
  MOTORCYCLE
  WALKING
  PUBLIC_TRANSPORT
}

enum program_status {
  PLANNING
  FIELDWORK
  DATA_CLEANING
  REPORTING
  COMPLETED
}

enum replacementrequest_matchLevel {
  VILLAGE
  CELL
  SECTOR
  DISTRICT
  PROVINCE
  OVERRIDE
}

enum user_gender {
  MALE
  FEMALE
  OTHER
}

enum user_status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum user_educationLevel {
  NONE
  PRIMARY
  SECONDARY
  BACHELORS
  MASTERS
  DOCTORATE
}

enum beneficiary_outcome {
  PENDING
  COMPLETED
  REFUSED
  NOT_FOUND
  RELOCATED
  DECEASED
  REPLACED
}
