generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// --- Rwanda's real administrative hierarchy, normalized -------------------
// Numeric ids matching the government reference codes (imported once via
// scripts/import-geo-sql.ts). `izina` on Province is the Kinyarwanda name.

model Province {
  id            Int           @id
  name          String        @db.VarChar(255)
  izina         String        @db.VarChar(255)
  createdAt     DateTime?     @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?     @map("updated_at") @db.Timestamp(0)
  districts     District[]
  users         User[]
  beneficiaries Beneficiary[]

  @@map("provinces")
}

model District {
  id            Int           @id
  name          String        @db.VarChar(255)
  provinceId    Int           @map("province")
  createdAt     DateTime?     @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?     @map("updated_at") @db.Timestamp(0)
  province      Province      @relation(fields: [provinceId], references: [id], map: "districts_province_fkey")
  sectors       Sector[]
  users         User[]
  beneficiaries Beneficiary[]

  @@index([provinceId], map: "districts_province_foreign")
  @@map("districts")
}

model Sector {
  id            Int           @id
  name          String        @db.VarChar(255)
  districtId    Int           @map("district")
  createdAt     DateTime?     @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?     @map("updated_at") @db.Timestamp(0)
  district      District      @relation(fields: [districtId], references: [id], map: "sectors_district_fkey")
  cells         Cell[]
  users         User[]
  beneficiaries Beneficiary[]

  @@index([districtId], map: "sectors_district_foreign")
  @@map("sectors")
}

model Cell {
  id            Int           @id
  name          String        @db.VarChar(255)
  sectorId      Int           @map("sector")
  createdAt     DateTime?     @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?     @map("updated_at") @db.Timestamp(0)
  sector        Sector        @relation(fields: [sectorId], references: [id], map: "cells_sector_fkey")
  villages      Village[]
  users         User[]
  beneficiaries Beneficiary[]

  @@index([sectorId], map: "cells_sector_foreign")
  @@map("cells")
}

model Village {
  id            Int           @id
  name          String        @db.VarChar(255)
  cellId        Int           @map("cell")
  createdAt     DateTime?     @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?     @map("updated_at") @db.Timestamp(0)
  cell          Cell          @relation(fields: [cellId], references: [id], map: "villages_cell_fkey")
  users         User[]
  beneficiaries Beneficiary[]

  @@index([cellId], map: "villages_cell_foreign")
  @@map("villages")
}

// ---------------------------------------------------------------------

model Notification {
  id         String           @id @default(uuid())
  type       NotificationType
  message    String
  entityType String?
  entityId   String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())
  tenantId   String?
  userId     String
  tenant     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "Notification_tenantId_fkey")
  @@index([userId], map: "Notification_userId_fkey")
}

model Tenant {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  activityLogs           ActivityLog[]
  beneficiaries          Beneficiary[]
  beneficiaryAssignments BeneficiaryAssignment[]
  fieldCheckIns          FieldCheckIn[]
  notifications          Notification[]
  programs               Program[]
  programAssignments     ProgramAssignment[]
  programTeams           ProgramTeam[]
  availabilityChecks     AvailabilityCheck[]
  fieldExpenses          FieldExpense[]
  mealTransportConfigs   MealTransportReportConfig[]
  mealTransportReports   MealTransportReport[]
  replacementRequests    ReplacementRequest[]
  roles                  Role[]
  users                  User[]
  vehicles               Vehicle[]
}

model Role {
  id                       String    @id @default(uuid())
  name                     String
  description              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  tenantId                 String
  permissions              Json?
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                    User[]
  programsAsTeamLeaderRole Program[] @relation("TeamLeaderRole")
  programsAsTeamMemberRole Program[] @relation("TeamMemberRole")
  programsAsCheckerRole    Program[] @relation("CheckerRole")
  mealTransportConfigs     MealTransportReportConfig[] @relation("MealTransportSubmitterRole")

  @@unique([tenantId, name])
}

model User {
  id                         String                  @id @default(uuid())
  email                      String                  @unique
  name                       String?
  firstName                  String?
  lastName                   String?
  avatarUrl                  String?
  password                   String
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  telephone                  String?
  // Set only for users created via the Supervisor & Enumerator group
  // import — the group's own code/name/area from that spreadsheet, so
  // people brought in together stay identifiable as one group before any
  // program-level assignment exists.
  groupCode                  String?
  groupName                  String?
  operationalArea            String?
  provinceId                 Int?
  districtId                 Int?
  sectorId                   Int?
  cellId                     Int?
  villageId                  Int?
  province                   Province?               @relation(fields: [provinceId], references: [id])
  district                   District?               @relation(fields: [districtId], references: [id])
  sector                     Sector?                 @relation(fields: [sectorId], references: [id])
  cell                       Cell?                   @relation(fields: [cellId], references: [id])
  village                    Village?                @relation(fields: [villageId], references: [id])
  gender                     Gender?
  dateOfBirth                DateTime?
  status                     UserStatus              @default(ACTIVE)
  educationLevel             EducationLevel?
  isPlatformAdmin            Boolean                 @default(false)
  tokenVersion               Int                     @default(0)
  roleId                     String?
  tenantId                   String?
  lastSeenAt                 DateTime?
  activityLogs               ActivityLog[]
  beneficiaryAssignments     BeneficiaryAssignment[]
  fieldCheckIns              FieldCheckIn[]
  notifications              Notification[]
  programAssignments         ProgramAssignment[]
  programTeamsLed            ProgramTeam[]           @relation("ProgramTeamLeader")
  programTeamMemberships     ProgramTeamMember[]
  availabilityChecks         AvailabilityCheck[]
  fieldExpensesSubmitted     FieldExpense[]          @relation("FieldExpenseSubmitter")
  fieldExpensesReviewed      FieldExpense[]          @relation("FieldExpenseReviewer")
  mealTransportReportsPrepared MealTransportReport[] @relation("MealTransportPreparer")
  mealTransportConfigsApproving MealTransportReportConfig[] @relation("MealTransportApprover")
  fieldVisitsConfirmed       FieldVisit[]            @relation("FieldVisitConfirmer")
  replacementRequestsDecided ReplacementRequest[]    @relation("DecidedBy")
  replacementRequestsMade    ReplacementRequest[]    @relation("RequestedBy")
  role                       Role?                   @relation(fields: [roleId], references: [id])
  tenant                     Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  passwordResetCodes         PasswordResetCode[]

  @@index([roleId], map: "User_roleId_fkey")
  @@index([tenantId], map: "User_tenantId_fkey")
  @@index([provinceId])
  @@index([districtId])
  @@index([sectorId])
  @@index([cellId])
  @@index([villageId])
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Program {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenantId           String
  endDate            DateTime?
  scenarioType       ScenarioType?
  scenarioTypeOther  String?
  startDate          DateTime?
  status             ProjectStatus       @default(PLANNING)
  statusOther        String?
  targetSampleSize   Int?
  tracingRequired    Boolean             @default(false)
  // Team-based field-ops config — all nullable until an admin configures them.
  teamCount          Int?
  membersPerTeam     Int?
  teamLeaderRoleId   String?
  teamMemberRoleId   String?
  checkerRoleId      String?
  teamLeaderRole     Role?               @relation("TeamLeaderRole", fields: [teamLeaderRoleId], references: [id], onDelete: SetNull)
  teamMemberRole     Role?               @relation("TeamMemberRole", fields: [teamMemberRoleId], references: [id], onDelete: SetNull)
  checkerRole        Role?               @relation("CheckerRole", fields: [checkerRoleId], references: [id], onDelete: SetNull)
  fieldCheckIns      FieldCheckIn[]
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments        ProgramAssignment[]
  teams              ProgramTeam[]
  availabilityChecks AvailabilityCheck[]
  fieldExpenses      FieldExpense[]
  mealTransportConfigs MealTransportReportConfig[]
  beneficiaries      Beneficiary[]       @relation("BeneficiaryToProgram")

  @@unique([tenantId, name])
  @@index([teamLeaderRoleId], map: "Program_teamLeaderRoleId_fkey")
  @@index([teamMemberRoleId], map: "Program_teamMemberRoleId_fkey")
  @@index([checkerRoleId], map: "Program_checkerRoleId_fkey")
}

model ProgramTeam {
  id              String               @id @default(uuid())
  programId       String
  tenantId        String
  name            String
  leaderId        String?
  // Set only when this team was created by "adopting" a pre-formed group
  // from the Supervisor & Enumerator import (User.groupCode) into a
  // program — lets the assignment UI tell which imported groups are
  // already linked to a given program vs. still available to adopt.
  sourceGroupCode String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  program         Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leader          User?                @relation("ProgramTeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members         ProgramTeamMember[]
  vehicles        ProgramTeamVehicle[]

  @@unique([programId, name])
  @@unique([programId, sourceGroupCode])
  @@index([tenantId], map: "ProgramTeam_tenantId_fkey")
  @@index([leaderId], map: "ProgramTeam_leaderId_fkey")
}

model ProgramTeamMember {
  id        String      @id @default(uuid())
  teamId    String
  programId String
  userId    String
  createdAt DateTime    @default(now())
  team      ProgramTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([teamId], map: "ProgramTeamMember_teamId_fkey")
  @@index([userId], map: "ProgramTeamMember_userId_fkey")
}

model ProgramTeamVehicle {
  id        String      @id @default(uuid())
  teamId    String
  vehicleId String
  createdAt DateTime    @default(now())
  team      ProgramTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  vehicle   Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([teamId, vehicleId])
  @@index([vehicleId], map: "ProgramTeamVehicle_vehicleId_fkey")
}

model AvailabilityCheck {
  id            String                  @id @default(uuid())
  programId     String
  beneficiaryId String
  userId        String
  tenantId      String
  status        AvailabilityCheckStatus @default(PENDING)
  notes         String?
  assignedAt    DateTime                @default(now())
  checkedAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  program       Program                 @relation(fields: [programId], references: [id], onDelete: Cascade)
  beneficiary   Beneficiary             @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([programId, beneficiaryId])
  @@index([beneficiaryId], map: "AvailabilityCheck_beneficiaryId_fkey")
  @@index([userId], map: "AvailabilityCheck_userId_fkey")
  @@index([tenantId], map: "AvailabilityCheck_tenantId_fkey")
}

// --- Weekly Meal & Transport Expense Report ---------------------------
// One config per (tenant, submitter role): which role fills the form, who
// approves it, and the project/title/subtitle text that appears on it.
// Any role can be configured as a submitter — Facilitator, Data Collector,
// or any other role a tenant defines.
model MealTransportReportConfig {
  id             String   @id @default(uuid())
  tenantId       String
  submitterRoleId String
  approverUserId String
  // A real, existing Program — confirmed by whoever manages this config,
  // not free text the report-filler could type themselves.
  programId      String
  title          String   @default("")
  subtitle       String   @default("Weekly Meal & Transport Expense Report Form")
  // How many days a report period covers, starting Monday — 7 for a full
  // calendar week, 5 for a Mon-Fri work week, or anything else a tenant
  // needs. Not automatic at 7; set explicitly per config.
  periodDays     Int      @default(7)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submitterRole  Role     @relation("MealTransportSubmitterRole", fields: [submitterRoleId], references: [id], onDelete: Cascade)
  approver       User     @relation("MealTransportApprover", fields: [approverUserId], references: [id], onDelete: Cascade)
  program        Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  reports        MealTransportReport[]

  @@unique([tenantId, submitterRoleId])
}

model MealTransportReport {
  id                    String                     @id @default(uuid())
  tenantId              String
  configId              String
  userId                String
  weekNumber            Int
  weekStart             DateTime
  weekEnd               DateTime
  status                MealTransportReportStatus  @default(DRAFT)
  preparerSignatureName String?
  // The actual hand-drawn signature — a PNG data URL from the canvas
  // signature pad, not a typed/rendered name.
  preparerSignatureImage String?                    @db.LongText
  preparerSignedAt      DateTime?
  approverSignatureName String?
  approverSignatureImage String?                    @db.LongText
  approverSignedAt      DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  config                MealTransportReportConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)
  user                  User                       @relation("MealTransportPreparer", fields: [userId], references: [id], onDelete: Cascade)
  entries               MealTransportReportEntry[]

  @@unique([userId, weekNumber])
  @@index([tenantId], map: "MealTransportReport_tenantId_fkey")
  @@index([configId], map: "MealTransportReport_configId_fkey")
}

model MealTransportReportEntry {
  id             String              @id @default(uuid())
  reportId       String
  date           DateTime
  mealUsd        Float               @default(0)
  accommodationUsd Float             @default(0)
  transportUsd   Float               @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  report         MealTransportReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, date])
  @@index([reportId], map: "MealTransportReportEntry_reportId_fkey")
}

model FieldExpense {
  id           String             @id @default(uuid())
  tenantId     String
  userId       String
  programId    String
  description  String
  amount       Float
  documentUrl  String?
  expenseDate  DateTime
  status       FieldExpenseStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User               @relation("FieldExpenseSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  program      Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  reviewedBy   User?              @relation("FieldExpenseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId], map: "FieldExpense_tenantId_fkey")
  @@index([userId], map: "FieldExpense_userId_fkey")
  @@index([programId], map: "FieldExpense_programId_fkey")
  @@index([reviewedById], map: "FieldExpense_reviewedById_fkey")
}

model Beneficiary {
  id                           String                  @id @default(uuid())
  code                         String
  name                         String
  telephone                    String?
  gender                       Gender?
  // Replaces dateOfBirth — an age band like "18-20" or "30-35" rather than
  // an exact birth date.
  ageRange                     String?
  status                       UserStatus              @default(ACTIVE)
  provinceId                   Int?
  districtId                   Int?
  sectorId                     Int?
  cellId                       Int?
  villageId                    Int?
  province                     Province?               @relation(fields: [provinceId], references: [id])
  district                     District?               @relation(fields: [districtId], references: [id])
  sector                       Sector?                 @relation(fields: [sectorId], references: [id])
  cell                         Cell?                   @relation(fields: [cellId], references: [id])
  village                      Village?                @relation(fields: [villageId], references: [id])
  ipName                       String?
  category                     String?
  // Never auto-generated — supplied by the tenant, typically via the
  // Excel import, replacing the old nationalId/householdSize fields.
  personalId                   String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  tenantId                     String
  consentAt                    DateTime?
  consentGiven                 Boolean                 @default(false)
  outcome                      ResponseOutcome         @default(PENDING)
  tenant                       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments                  BeneficiaryAssignment[]
  fieldVisits                  FieldVisit[]
  availabilityChecks           AvailabilityCheck[]
  candidateReplacementRequests ReplacementRequest[]    @relation("CandidateRespondent")
  originalReplacementRequests  ReplacementRequest[]    @relation("OriginalRespondent")
  programs                     Program[]               @relation("BeneficiaryToProgram")

  @@unique([tenantId, code])
  @@unique([tenantId, personalId])
  @@index([provinceId])
  @@index([districtId])
  @@index([sectorId])
  @@index([cellId])
  @@index([villageId])
}

model ProgramAssignment {
  id         String           @id @default(uuid())
  status     AssignmentStatus @default(ACTIVE)
  assignedAt DateTime         @default(now())
  endedAt    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  userId     String
  programId  String
  tenantId   String
  program    Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([programId], map: "ProgramAssignment_programId_fkey")
  @@index([tenantId], map: "ProgramAssignment_tenantId_fkey")
  @@index([userId], map: "ProgramAssignment_userId_fkey")
}

model BeneficiaryAssignment {
  id            String           @id @default(uuid())
  status        AssignmentStatus @default(ACTIVE)
  assignedAt    DateTime         @default(now())
  endedAt       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  beneficiaryId String
  userId        String
  tenantId      String
  transportMode TransportMode?
  vehicleId     String?
  beneficiary   Beneficiary      @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?         @relation(fields: [vehicleId], references: [id])

  @@index([beneficiaryId], map: "BeneficiaryAssignment_beneficiaryId_fkey")
  @@index([tenantId], map: "BeneficiaryAssignment_tenantId_fkey")
  @@index([userId], map: "BeneficiaryAssignment_userId_fkey")
  @@index([vehicleId], map: "BeneficiaryAssignment_vehicleId_fkey")
}

model Vehicle {
  id             String                  @id @default(uuid())
  name           String
  type           VehicleType             @default(VEHICLE)
  driverName     String?
  capacityPerDay Int?
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  tenantId       String
  assignments    BeneficiaryAssignment[]
  teams          ProgramTeamVehicle[]
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "Vehicle_tenantId_fkey")
}

model ReplacementRequest {
  id                    String            @id @default(uuid())
  reason                String
  status                ReplacementStatus @default(PENDING)
  createdAt             DateTime          @default(now())
  decidedAt             DateTime?
  tenantId              String
  originalRespondentId  String
  candidateRespondentId String?
  requestedByUserId     String
  decidedByUserId       String?
  matchLevel            GeoMatchLevel?
  overrideReason        String?
  candidateRespondent   Beneficiary?      @relation("CandidateRespondent", fields: [candidateRespondentId], references: [id])
  decidedBy             User?             @relation("DecidedBy", fields: [decidedByUserId], references: [id])
  originalRespondent    Beneficiary       @relation("OriginalRespondent", fields: [originalRespondentId], references: [id], onDelete: Cascade)
  requestedBy           User              @relation("RequestedBy", fields: [requestedByUserId], references: [id])
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([candidateRespondentId], map: "ReplacementRequest_candidateRespondentId_fkey")
  @@index([decidedByUserId], map: "ReplacementRequest_decidedByUserId_fkey")
  @@index([originalRespondentId], map: "ReplacementRequest_originalRespondentId_fkey")
  @@index([requestedByUserId], map: "ReplacementRequest_requestedByUserId_fkey")
  @@index([tenantId], map: "ReplacementRequest_tenantId_fkey")
}

model FieldCheckIn {
  id                     String       @id @default(uuid())
  checkInAt              DateTime     @default(now())
  checkOutAt             DateTime?
  gpsLat                 Float?
  gpsLng                 Float?
  note                   String?
  tenantId               String
  userId                 String
  projectId              String?
  currentGpsLat          Float?
  currentGpsLng          Float?
  currentGpsAt           DateTime?
  currentGpsNote         String?
  checkoutOverrideReason String?
  project                Program?     @relation(fields: [projectId], references: [id])
  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes                  FieldNote[]
  visits                 FieldVisit[]

  @@index([projectId], map: "FieldCheckIn_projectId_fkey")
  @@index([tenantId], map: "FieldCheckIn_tenantId_fkey")
  @@index([userId], map: "FieldCheckIn_userId_fkey")
}

model FieldVisit {
  id                 String              @id @default(uuid())
  outcome            ResponseOutcome     @default(PENDING)
  note               String?
  recordedAt         DateTime            @default(now())
  checkInId          String
  beneficiaryId      String
  confirmationStatus ConfirmationStatus  @default(PENDING)
  confirmedAt        DateTime?
  confirmedById      String?
  rejectionReason    String?
  beneficiary        Beneficiary         @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  checkIn            FieldCheckIn        @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  confirmedBy        User?               @relation("FieldVisitConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([checkInId, beneficiaryId])
  @@index([beneficiaryId], map: "FieldVisit_beneficiaryId_fkey")
  @@index([confirmedById], map: "FieldVisit_confirmedById_fkey")
}

model FieldNote {
  id        String       @id @default(uuid())
  note      String
  createdAt DateTime     @default(now())
  checkInId String
  checkIn   FieldCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([checkInId], map: "FieldNote_checkInId_fkey")
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenantId   String?
  userId     String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId], map: "ActivityLog_tenantId_fkey")
  @@index([userId], map: "ActivityLog_userId_fkey")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EducationLevel {
  NONE
  PRIMARY
  SECONDARY
  BACHELORS
  MASTERS
  DOCTORATE
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum ScenarioType {
  BASELINE_SURVEY
  ENDLINE_SURVEY
  TRACER_STUDY
  PROGRAM_OUTCOME_ASSESSMENT
  QUALITATIVE_STUDY
  OTHER
