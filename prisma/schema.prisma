generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Notification {
  id         String           @id @default(uuid())
  type       NotificationType
  message    String
  entityType String?
  entityId   String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())
  tenantId   String?
  userId     String
  tenant     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "Notification_tenantId_fkey")
  @@index([userId], map: "Notification_userId_fkey")
}

model Tenant {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  activityLogs           ActivityLog[]
  beneficiaries          Beneficiary[]
  beneficiaryAssignments BeneficiaryAssignment[]
  fieldCheckIns          FieldCheckIn[]
  notifications          Notification[]
  programs               Program[]
  programAssignments     ProgramAssignment[]
  replacementRequests    ReplacementRequest[]
  roles                  Role[]
  users                  User[]
  vehicles               Vehicle[]
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  permissions Json?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([tenantId, name])
}

model User {
  id                         String                  @id @default(uuid())
  email                      String                  @unique
  name                       String?
  firstName                  String?
  lastName                   String?
  avatarUrl                  String?
  password                   String
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  telephone                  String?
  province                   String?
  district                   String?
  sector                     String?
  gender                     Gender?
  dateOfBirth                DateTime?
  status                     UserStatus              @default(ACTIVE)
  educationLevel             EducationLevel?
  isPlatformAdmin            Boolean                 @default(false)
  tokenVersion               Int                     @default(0)
  roleId                     String?
  tenantId                   String?
  lastSeenAt                 DateTime?
  cell                       String?
  village                    String?
  activityLogs               ActivityLog[]
  beneficiaryAssignments     BeneficiaryAssignment[]
  fieldCheckIns              FieldCheckIn[]
  notifications              Notification[]
  programAssignments         ProgramAssignment[]
  replacementRequestsDecided ReplacementRequest[]    @relation("DecidedBy")
  replacementRequestsMade    ReplacementRequest[]    @relation("RequestedBy")
  role                       Role?                   @relation(fields: [roleId], references: [id])
  tenant                     Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  passwordResetCodes         PasswordResetCode[]

  @@index([roleId], map: "User_roleId_fkey")
  @@index([tenantId], map: "User_tenantId_fkey")
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminLocation {
  id       String @id @default(uuid())
  province String
  district String
  sector   String
  cell     String
  village  String

  @@unique([province, district, sector, cell, village], map: "AdminLocation_full_path_key")
  @@index([province], map: "AdminLocation_province_idx")
  @@index([province, district], map: "AdminLocation_province_district_idx")
  @@index([province, district, sector], map: "AdminLocation_pds_idx")
  @@index([province, district, sector, cell], map: "AdminLocation_pdsc_idx")
}

model Program {
  id               String              @id @default(uuid())
  name             String
  description      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenantId         String
  endDate          DateTime?
  scenarioType     ScenarioType?
  startDate        DateTime?
  status           ProjectStatus       @default(PLANNING)
  targetSampleSize Int?
  fieldCheckIns    FieldCheckIn[]
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments      ProgramAssignment[]
  beneficiaries    Beneficiary[]       @relation("BeneficiaryToProgram")

  @@unique([tenantId, name])
}

model Beneficiary {
  id                           String                  @id @default(uuid())
  code                         String
  name                         String
  telephone                    String?
  gender                       Gender?
  dateOfBirth                  DateTime?
  status                       UserStatus              @default(ACTIVE)
  province                     String?
  district                     String?
  sector                       String?
  nationalId                   String?
  householdSize                Int?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  tenantId                     String
  consentAt                    DateTime?
  consentGiven                 Boolean                 @default(false)
  outcome                      ResponseOutcome         @default(PENDING)
  cell                         String?
  village                      String?
  tenant                       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments                  BeneficiaryAssignment[]
  fieldVisits                  FieldVisit[]
  candidateReplacementRequests ReplacementRequest[]    @relation("CandidateRespondent")
  originalReplacementRequests  ReplacementRequest[]    @relation("OriginalRespondent")
  programs                     Program[]               @relation("BeneficiaryToProgram")

  @@unique([tenantId, code])
  @@unique([tenantId, nationalId])
}

model ProgramAssignment {
  id         String           @id @default(uuid())
  status     AssignmentStatus @default(ACTIVE)
  assignedAt DateTime         @default(now())
  endedAt    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  userId     String
  programId  String
  tenantId   String
  program    Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([programId], map: "ProgramAssignment_programId_fkey")
  @@index([tenantId], map: "ProgramAssignment_tenantId_fkey")
  @@index([userId], map: "ProgramAssignment_userId_fkey")
}

model BeneficiaryAssignment {
  id            String           @id @default(uuid())
  status        AssignmentStatus @default(ACTIVE)
  assignedAt    DateTime         @default(now())
  endedAt       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  beneficiaryId String
  userId        String
  tenantId      String
  transportMode TransportMode?
  vehicleId     String?
  beneficiary   Beneficiary      @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?         @relation(fields: [vehicleId], references: [id])

  @@index([beneficiaryId], map: "BeneficiaryAssignment_beneficiaryId_fkey")
  @@index([tenantId], map: "BeneficiaryAssignment_tenantId_fkey")
  @@index([userId], map: "BeneficiaryAssignment_userId_fkey")
  @@index([vehicleId], map: "BeneficiaryAssignment_vehicleId_fkey")
}

model Vehicle {
  id             String                  @id @default(uuid())
  name           String
  type           VehicleType             @default(VEHICLE)
  driverName     String?
  capacityPerDay Int?
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  tenantId       String
  assignments    BeneficiaryAssignment[]
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "Vehicle_tenantId_fkey")
}

model ReplacementRequest {
  id                    String            @id @default(uuid())
  reason                String
  status                ReplacementStatus @default(PENDING)
  createdAt             DateTime          @default(now())
  decidedAt             DateTime?
  tenantId              String
  originalRespondentId  String
  candidateRespondentId String?
  requestedByUserId     String
  decidedByUserId       String?
  matchLevel            GeoMatchLevel?
  overrideReason        String?
  candidateRespondent   Beneficiary?      @relation("CandidateRespondent", fields: [candidateRespondentId], references: [id])
  decidedBy             User?             @relation("DecidedBy", fields: [decidedByUserId], references: [id])
  originalRespondent    Beneficiary       @relation("OriginalRespondent", fields: [originalRespondentId], references: [id], onDelete: Cascade)
  requestedBy           User              @relation("RequestedBy", fields: [requestedByUserId], references: [id])
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([candidateRespondentId], map: "ReplacementRequest_candidateRespondentId_fkey")
  @@index([decidedByUserId], map: "ReplacementRequest_decidedByUserId_fkey")
  @@index([originalRespondentId], map: "ReplacementRequest_originalRespondentId_fkey")
  @@index([requestedByUserId], map: "ReplacementRequest_requestedByUserId_fkey")
  @@index([tenantId], map: "ReplacementRequest_tenantId_fkey")
}

model FieldCheckIn {
  id                     String       @id @default(uuid())
  checkInAt              DateTime     @default(now())
  checkOutAt             DateTime?
  gpsLat                 Float?
  gpsLng                 Float?
  note                   String?
  tenantId               String
  userId                 String
  projectId              String?
  currentGpsLat          Float?
  currentGpsLng          Float?
  currentGpsAt           DateTime?
  currentGpsNote         String?
  checkoutOverrideReason String?
  project                Program?     @relation(fields: [projectId], references: [id])
  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes                  FieldNote[]
  visits                 FieldVisit[]

  @@index([projectId], map: "FieldCheckIn_projectId_fkey")
  @@index([tenantId], map: "FieldCheckIn_tenantId_fkey")
  @@index([userId], map: "FieldCheckIn_userId_fkey")
}

model FieldVisit {
  id            String          @id @default(uuid())
  outcome       ResponseOutcome @default(PENDING)
  note          String?
  recordedAt    DateTime        @default(now())
  checkInId     String
  beneficiaryId String
  beneficiary   Beneficiary     @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  checkIn       FieldCheckIn    @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@unique([checkInId, beneficiaryId])
  @@index([beneficiaryId], map: "FieldVisit_beneficiaryId_fkey")
}

model FieldNote {
  id        String       @id @default(uuid())
  note      String
  createdAt DateTime     @default(now())
  checkInId String
  checkIn   FieldCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([checkInId], map: "FieldNote_checkInId_fkey")
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenantId   String?
  userId     String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId], map: "ActivityLog_tenantId_fkey")
  @@index([userId], map: "ActivityLog_userId_fkey")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EducationLevel {
  NONE
  PRIMARY
  SECONDARY
  BACHELORS
  MASTERS
  DOCTORATE
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum ScenarioType {
  BASELINE_SURVEY
  ENDLINE_SURVEY
  TRACER_STUDY
  PROGRAM_OUTCOME_ASSESSMENT
  QUALITATIVE_STUDY
}

enum ProjectStatus {
  PLANNING
  FIELDWORK
  DATA_CLEANING
  REPORTING
  COMPLETED
}

enum ResponseOutcome {
  PENDING
  COMPLETED
  REFUSED
  NOT_FOUND
  RELOCATED
  DECEASED
  REPLACED
}

enum ReplacementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GeoMatchLevel {
  VILLAGE
  CELL
  SECTOR
  DISTRICT
  PROVINCE
  OVERRIDE
}

enum VehicleType {
  VEHICLE
  MOTORCYCLE
}

enum TransportMode {
  NONE
  VEHICLE
  MOTORCYCLE
  WALKING
  PUBLIC_TRANSPORT
}

enum NotificationType {
  ASSIGNMENT_PROGRAM
  ASSIGNMENT_BENEFICIARY
  REPLACEMENT_REQUESTED
  REPLACEMENT_DECIDED
  SYSTEM
}
