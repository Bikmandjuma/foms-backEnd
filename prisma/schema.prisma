generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Notification {
  id         String           @id @default(uuid())
  type       NotificationType
  message    String
  entityType String?
  entityId   String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())
  tenantId   String?
  userId     String
  tenant     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "Notification_tenantId_fkey")
  @@index([userId], map: "Notification_userId_fkey")
}

model Tenant {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  activityLogs           ActivityLog[]
  availabilityChecks     AvailabilityCheck[]
  beneficiaries          Beneficiary[]
  beneficiaryAssignments BeneficiaryAssignment[]
  fieldCheckIns          FieldCheckIn[]
  fieldExpenses          FieldExpense[]
  notifications          Notification[]
  programs               Program[]
  programAssignments     ProgramAssignment[]
  programTeams           ProgramTeam[]
  replacementRequests    ReplacementRequest[]
  roles                  Role[]
  users                  User[]
  vehicles               Vehicle[]
}

model Role {
  id                         String    @id @default(uuid())
  name                       String
  description                String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  tenantId                   String
  permissions                Json?
  tenant                     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                      User[]
  programsUsingAsLeaderRole  Program[] @relation("ProgramTeamLeaderRole")
  programsUsingAsMemberRole  Program[] @relation("ProgramTeamMemberRole")
  programsUsingAsCheckerRole Program[] @relation("ProgramCheckerRole")

  @@unique([tenantId, name])
}

model User {
  id                         String                  @id @default(uuid())
  email                      String                  @unique
  name                       String?
  firstName                  String?
  lastName                   String?
  avatarUrl                  String?
  password                   String
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  telephone                  String?
  gender                     Gender?
  dateOfBirth                DateTime?
  status                     UserStatus              @default(ACTIVE)
  educationLevel             EducationLevel?
  isPlatformAdmin            Boolean                 @default(false)
  tokenVersion               Int                     @default(0)
  roleId                     String?
  tenantId                   String?
  lastSeenAt                 DateTime?
  provinceId                 Int?
  districtId                 Int?
  sectorId                   Int?
  cellId                     Int?
  villageId                  Int?
  activityLogs               ActivityLog[]
  availabilityChecks         AvailabilityCheck[]
  beneficiaryAssignments     BeneficiaryAssignment[]
  fieldCheckIns              FieldCheckIn[]
  fieldExpensesSubmitted     FieldExpense[]          @relation("FieldExpenseSubmitter")
  fieldExpensesReviewed      FieldExpense[]          @relation("FieldExpenseReviewer")
  notifications              Notification[]
  programAssignments         ProgramAssignment[]
  replacementRequestsDecided ReplacementRequest[]    @relation("DecidedBy")
  replacementRequestsMade    ReplacementRequest[]    @relation("RequestedBy")
  role                       Role?                   @relation(fields: [roleId], references: [id])
  tenant                     Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  province                   Province?               @relation(fields: [provinceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  district                   District?               @relation(fields: [districtId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sector                     Sector?                 @relation(fields: [sectorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cell                       Cell?                   @relation(fields: [cellId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  village                    Village?                @relation(fields: [villageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  passwordResetCodes         PasswordResetCode[]
  teamsLed                   ProgramTeam[]           @relation("ProgramTeamLeader")
  teamMemberships            ProgramTeamMember[]     @relation("ProgramTeamMember")
  fieldVisitsConfirmed       FieldVisit[]            @relation("FieldVisitConfirmedBy")

  @@index([roleId], map: "User_roleId_fkey")
  @@index([tenantId], map: "User_tenantId_fkey")
  @@index([provinceId], map: "User_provinceId_fkey")
  @@index([districtId], map: "User_districtId_fkey")
  @@index([sectorId], map: "User_sectorId_fkey")
  @@index([cellId], map: "User_cellId_fkey")
  @@index([villageId], map: "User_villageId_fkey")
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Province {
  id            Int           @id
  name          String
  izina         String
  createdAt     DateTime?     @map("created_at")
  updatedAt     DateTime?     @map("updated_at")
  districts     District[]
  users         User[]
  beneficiaries Beneficiary[]

  @@map("provinces")
}

model District {
  id            Int           @id
  name          String
  provinceId    Int           @map("province")
  createdAt     DateTime?     @map("created_at")
  updatedAt     DateTime?     @map("updated_at")
  province      Province      @relation(fields: [provinceId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "districts_province_fkey")
  sectors       Sector[]
  users         User[]
  beneficiaries Beneficiary[]

  @@map("districts")
}

model Sector {
  id            Int           @id
  name          String
  districtId    Int           @map("district")
  createdAt     DateTime?     @map("created_at")
  updatedAt     DateTime?     @map("updated_at")
  district      District      @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "sectors_district_fkey")
  cells         Cell[]
  users         User[]
  beneficiaries Beneficiary[]

  @@map("sectors")
}

model Cell {
  id            Int           @id
  name          String
  sectorId      Int           @map("sector")
  createdAt     DateTime?     @map("created_at")
  updatedAt     DateTime?     @map("updated_at")
  sector        Sector        @relation(fields: [sectorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "cells_sector_fkey")
  villages      Village[]
  users         User[]
  beneficiaries Beneficiary[]

  @@map("cells")
}

model Village {
  id            Int           @id
  name          String
  cellId        Int           @map("cell")
  createdAt     DateTime?     @map("created_at")
  updatedAt     DateTime?     @map("updated_at")
  cell          Cell          @relation(fields: [cellId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "villages_cell_fkey")
  users         User[]
  beneficiaries Beneficiary[]

  @@map("villages")
}

model Program {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenantId           String
  endDate            DateTime?
  scenarioType       ScenarioType?
  startDate          DateTime?
  status             ProjectStatus       @default(PLANNING)
  targetSampleSize   Int?
  teamCount          Int?
  membersPerTeam     Int?
  teamLeaderRoleId   String?
  teamMemberRoleId   String?
  checkerRoleId      String?
  tracingRequired    Boolean             @default(false)
  fieldCheckIns      FieldCheckIn[]
  fieldExpenses      FieldExpense[]
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments        ProgramAssignment[]
  beneficiaries      Beneficiary[]       @relation("BeneficiaryToProgram")
  teamLeaderRole     Role?               @relation("ProgramTeamLeaderRole", fields: [teamLeaderRoleId], references: [id])
  teamMemberRole     Role?               @relation("ProgramTeamMemberRole", fields: [teamMemberRoleId], references: [id])
  checkerRole        Role?               @relation("ProgramCheckerRole", fields: [checkerRoleId], references: [id])
  teams              ProgramTeam[]
  availabilityChecks AvailabilityCheck[]

  @@unique([tenantId, name])
  @@index([teamLeaderRoleId], map: "Program_teamLeaderRoleId_fkey")
  @@index([teamMemberRoleId], map: "Program_teamMemberRoleId_fkey")
  @@index([checkerRoleId], map: "Program_checkerRoleId_fkey")
}

enum AvailabilityCheckStatus {
  PENDING
  AVAILABLE
  REFUSED
  NOT_FOUND
  RELOCATED
  DECEASED
}

/**
 * "Confirm availability" — an independent workflow from the geo-assignment
 * engine (ProgramAssignment/BeneficiaryAssignment). A program picks one
 * "checker" role; every respondent enrolled in the program gets handed to
 * an active user holding that role, whose job is to confirm the respondent
 * is actually reachable/available. Starts PENDING; the checker (mobile app)
 * later submits one of the other statuses plus an optional free-text note.
 */
model AvailabilityCheck {
  id            String                  @id @default(uuid())
  programId     String
  beneficiaryId String
  userId        String
  tenantId      String
  status        AvailabilityCheckStatus @default(PENDING)
  notes         String?
  assignedAt    DateTime                @default(now())
  checkedAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  program     Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([programId, beneficiaryId])
  @@index([beneficiaryId], map: "AvailabilityCheck_beneficiaryId_fkey")
  @@index([userId], map: "AvailabilityCheck_userId_fkey")
  @@index([tenantId], map: "AvailabilityCheck_tenantId_fkey")
}

model Beneficiary {
  id                           String                  @id @default(uuid())
  code                         String
  name                         String
  telephone                    String?
  gender                       Gender?
  dateOfBirth                  DateTime?
  status                       UserStatus              @default(ACTIVE)
  nationalId                   String?
  householdSize                Int?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  tenantId                     String
  consentAt                    DateTime?
  consentGiven                 Boolean                 @default(false)
  outcome                      ResponseOutcome         @default(PENDING)
  provinceId                   Int?
  districtId                   Int?
  sectorId                     Int?
  cellId                       Int?
  villageId                    Int?
  tenant                       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  province                     Province?               @relation(fields: [provinceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  district                     District?               @relation(fields: [districtId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sector                       Sector?                 @relation(fields: [sectorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cell                         Cell?                   @relation(fields: [cellId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  village                      Village?                @relation(fields: [villageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignments                  BeneficiaryAssignment[]
  availabilityChecks           AvailabilityCheck[]
  fieldVisits                  FieldVisit[]
  candidateReplacementRequests ReplacementRequest[]    @relation("CandidateRespondent")
  originalReplacementRequests  ReplacementRequest[]    @relation("OriginalRespondent")
  programs                     Program[]               @relation("BeneficiaryToProgram")

  @@unique([tenantId, code])
  @@unique([tenantId, nationalId])
  @@index([provinceId], map: "Beneficiary_provinceId_fkey")
  @@index([districtId], map: "Beneficiary_districtId_fkey")
  @@index([sectorId], map: "Beneficiary_sectorId_fkey")
  @@index([cellId], map: "Beneficiary_cellId_fkey")
  @@index([villageId], map: "Beneficiary_villageId_fkey")
}

model ProgramAssignment {
  id         String           @id @default(uuid())
  status     AssignmentStatus @default(ACTIVE)
  assignedAt DateTime         @default(now())
  endedAt    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  userId     String
  programId  String
  tenantId   String
  program    Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([programId], map: "ProgramAssignment_programId_fkey")
  @@index([tenantId], map: "ProgramAssignment_tenantId_fkey")
  @@index([userId], map: "ProgramAssignment_userId_fkey")
}

model ProgramTeam {
  id        String   @id @default(uuid())
  programId String
  tenantId  String
  name      String
  leaderId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program  Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leader   User?                @relation("ProgramTeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members  ProgramTeamMember[]
  vehicles ProgramTeamVehicle[]

  @@unique([programId, name])
  @@index([tenantId], map: "ProgramTeam_tenantId_fkey")
  @@index([leaderId], map: "ProgramTeam_leaderId_fkey")
}

model ProgramTeamVehicle {
  id        String   @id @default(uuid())
  teamId    String
  vehicleId String
  createdAt DateTime @default(now())

  team    ProgramTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([teamId, vehicleId])
  @@index([vehicleId], map: "ProgramTeamVehicle_vehicleId_fkey")
}

model ProgramTeamMember {
  id        String   @id @default(uuid())
  teamId    String
  programId String
  userId    String
  createdAt DateTime @default(now())

  team ProgramTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User        @relation("ProgramTeamMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([teamId], map: "ProgramTeamMember_teamId_fkey")
}

model BeneficiaryAssignment {
  id            String           @id @default(uuid())
  status        AssignmentStatus @default(ACTIVE)
  assignedAt    DateTime         @default(now())
  endedAt       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  beneficiaryId String
  userId        String
  tenantId      String
  transportMode TransportMode?
  vehicleId     String?
  beneficiary   Beneficiary      @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?         @relation(fields: [vehicleId], references: [id])

  @@index([beneficiaryId], map: "BeneficiaryAssignment_beneficiaryId_fkey")
  @@index([tenantId], map: "BeneficiaryAssignment_tenantId_fkey")
  @@index([userId], map: "BeneficiaryAssignment_userId_fkey")
  @@index([vehicleId], map: "BeneficiaryAssignment_vehicleId_fkey")
}

model Vehicle {
  id              String                  @id @default(uuid())
  name            String
  type            VehicleType             @default(VEHICLE)
  driverName      String?
  capacityPerDay  Int?
  active          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  tenantId        String
  assignments     BeneficiaryAssignment[]
  teamAssignments ProgramTeamVehicle[]
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "Vehicle_tenantId_fkey")
}

model ReplacementRequest {
  id                    String            @id @default(uuid())
  reason                String
  status                ReplacementStatus @default(PENDING)
  createdAt             DateTime          @default(now())
  decidedAt             DateTime?
  tenantId              String
  originalRespondentId  String
  candidateRespondentId String?
  requestedByUserId     String
  decidedByUserId       String?
  matchLevel            GeoMatchLevel?
  overrideReason        String?
  candidateRespondent   Beneficiary?      @relation("CandidateRespondent", fields: [candidateRespondentId], references: [id])
  decidedBy             User?             @relation("DecidedBy", fields: [decidedByUserId], references: [id])
  originalRespondent    Beneficiary       @relation("OriginalRespondent", fields: [originalRespondentId], references: [id], onDelete: Cascade)
  requestedBy           User              @relation("RequestedBy", fields: [requestedByUserId], references: [id])
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([candidateRespondentId], map: "ReplacementRequest_candidateRespondentId_fkey")
  @@index([decidedByUserId], map: "ReplacementRequest_decidedByUserId_fkey")
  @@index([originalRespondentId], map: "ReplacementRequest_originalRespondentId_fkey")
  @@index([requestedByUserId], map: "ReplacementRequest_requestedByUserId_fkey")
  @@index([tenantId], map: "ReplacementRequest_tenantId_fkey")
}

model FieldCheckIn {
  id                     String       @id @default(uuid())
  checkInAt              DateTime     @default(now())
  checkOutAt             DateTime?
  gpsLat                 Float?
  gpsLng                 Float?
  note                   String?
  tenantId               String
  userId                 String
  projectId              String?
  currentGpsLat          Float?
  currentGpsLng          Float?
  currentGpsAt           DateTime?
  currentGpsNote         String?
  checkoutOverrideReason String?
  project                Program?     @relation(fields: [projectId], references: [id])
  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes                  FieldNote[]
  visits                 FieldVisit[]

  @@index([projectId], map: "FieldCheckIn_projectId_fkey")
  @@index([tenantId], map: "FieldCheckIn_tenantId_fkey")
  @@index([userId], map: "FieldCheckIn_userId_fkey")
}

model FieldVisit {
  id                 String             @id @default(uuid())
  outcome            ResponseOutcome    @default(PENDING)
  note               String?
  recordedAt         DateTime           @default(now())
  checkInId          String
  beneficiaryId      String
  confirmationStatus ConfirmationStatus @default(PENDING)
  confirmedById      String?
  confirmedAt        DateTime?
  rejectionReason    String?
  beneficiary        Beneficiary        @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  checkIn            FieldCheckIn       @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  confirmedBy        User?              @relation("FieldVisitConfirmedBy", fields: [confirmedById], references: [id])

  @@unique([checkInId, beneficiaryId])
  @@index([beneficiaryId], map: "FieldVisit_beneficiaryId_fkey")
  @@index([confirmedById], map: "FieldVisit_confirmedById_fkey")
}

model FieldNote {
  id        String       @id @default(uuid())
  note      String
  createdAt DateTime     @default(now())
  checkInId String
  checkIn   FieldCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([checkInId], map: "FieldNote_checkInId_fkey")
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenantId   String?
  userId     String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId], map: "ActivityLog_tenantId_fkey")
  @@index([userId], map: "ActivityLog_userId_fkey")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EducationLevel {
  NONE
  PRIMARY
  SECONDARY
  BACHELORS
  MASTERS
  DOCTORATE
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum ScenarioType {
  BASELINE_SURVEY
  ENDLINE_SURVEY
  TRACER_STUDY
  PROGRAM_OUTCOME_ASSESSMENT
  QUALITATIVE_STUDY
}

enum ProjectStatus {
  PLANNING
  FIELDWORK
  DATA_CLEANING
  REPORTING
  COMPLETED
}

enum ResponseOutcome {
  PENDING
  COMPLETED
  REFUSED
  NOT_FOUND
  RELOCATED
  DECEASED
  REPLACED
}

// A supervisor's review of one FieldVisit's recorded outcome. Independent of
// ResponseOutcome itself — the enumerator's finding (COMPLETED, REFUSED, ...)
// stands as recorded either way; this only tracks whether a supervisor has
// signed off on it. REJECTED flags it as disputed rather than reopening it
// for the enumerator to re-record.
enum ConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ReplacementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GeoMatchLevel {
  VILLAGE
  CELL
  SECTOR
  DISTRICT
  PROVINCE
  OVERRIDE
}

enum VehicleType {
  VEHICLE
  MOTORCYCLE
}

enum TransportMode {
  NONE
  VEHICLE
  MOTORCYCLE
  WALKING
  PUBLIC_TRANSPORT
}

enum NotificationType {
  ASSIGNMENT_PROGRAM
  ASSIGNMENT_BENEFICIARY
  REPLACEMENT_REQUESTED
  REPLACEMENT_DECIDED
  EXPENSE_REVIEWED
  OUTCOME_REVIEWED
  SYSTEM
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model FieldExpense {
  id           String        @id @default(uuid())
  tenantId     String
  userId       String
  programId    String
  description  String
  amount       Float
  documentUrl  String?
  expenseDate  DateTime
  status       ExpenseStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User    @relation("FieldExpenseSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("FieldExpenseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId], map: "FieldExpense_tenantId_fkey")
  @@index([userId], map: "FieldExpense_userId_fkey")
  @@index([programId], map: "FieldExpense_programId_fkey")
  @@index([reviewedById], map: "FieldExpense_reviewedById_fkey")
}
