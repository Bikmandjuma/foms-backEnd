DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=survey

PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-in-production"

# Optional — if unset, forgot-password codes are printed to the server
# console instead of emailed (fine for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Field Operation MS <no-reply@fieldops.local>"

# SMS_MODE=live sends real texts via mista.io (requires SMS_API_TOKEN) and
# uses real random OTP codes. Any other value (including unset — the
# default) keeps everything in dev mode: no real SMS is sent, and every OTP
# is always "123456" so you never need to read the console to test.
SMS_MODE=dev
SMS_API_TOKEN=
SMS_SENDER_ID=E-Notifier
